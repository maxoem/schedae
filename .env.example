# ==============================================================================
# Schedae — Environment Configuration
# ==============================================================================

# Public deployment URL (used for sitemap.xml, robots.txt, and metadata)
SITE_URL=http://localhost:8080
VITE_SITE_URL=http://localhost:8080

# Contact email address displayed on the Open Source / contact page
VITE_CONTACT_EMAIL=contact@example.com

# Optional: Privacy-friendly analytics (e.g. Umami)
# Injected dynamically into Nginx runtime and Content Security Policy
ANALYTICS_WEBSITE_ID=
ANALYTICS_HOST=
